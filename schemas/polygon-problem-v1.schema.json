{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipackaging.local/schemas/polygon-problem-v1.schema.json",
  "title": "AIPackaging polygon problem v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "problemId", "sheet", "manufacturing", "parts", "objective"],
  "properties": {
    "format": {"const": "aipackaging.polygon_problem"},
    "version": {"const": 1},
    "problemId": {"type": "string", "minLength": 1},
    "sheet": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height", "unit"],
      "properties": {
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
        "unit": {"const": "mm"}
      }
    },
    "manufacturing": {
      "type": "object", "additionalProperties": false,
      "required": ["sheetMargin", "partSpacing", "kerf", "curveTolerance"],
      "properties": {
        "sheetMargin": {"type": "number", "minimum": 0},
        "partSpacing": {"type": "number", "minimum": 0},
        "kerf": {"type": "number", "minimum": 0},
        "curveTolerance": {"type": "number", "minimum": 0.001, "maximum": 0.05}
      }
    },
    "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}},
    "objective": {
      "type": "object", "additionalProperties": false, "required": ["type", "version"],
      "properties": {"type": {"const": "valuable_right_remnant"}, "version": {"const": 1}}
    }
  },
  "$defs": {
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
    },
    "segment": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "end"],
         "properties": {"type": {"const": "line"}, "end": {"$ref": "#/$defs/point"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "end", "center", "clockwise"],
         "properties": {"type": {"const": "arc"}, "end": {"$ref": "#/$defs/point"},
                        "center": {"$ref": "#/$defs/point"}, "clockwise": {"type": "boolean"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "end", "control1", "control2"],
         "properties": {"type": {"const": "cubic_bezier"}, "end": {"$ref": "#/$defs/point"},
                        "control1": {"$ref": "#/$defs/point"}, "control2": {"$ref": "#/$defs/point"}}}
      ]
    },
    "path": {
      "type": "object", "additionalProperties": false, "required": ["start", "segments"],
      "properties": {"start": {"$ref": "#/$defs/point"},
                     "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}}}
    },
    "part": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "quantity", "outer", "holes", "allowedRotations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "quantity": {"type": "integer", "minimum": 1},
        "outer": {"$ref": "#/$defs/path"},
        "holes": {"type": "array", "items": {"$ref": "#/$defs/path"}},
        "allowedRotations": {"type": "array", "minItems": 1, "uniqueItems": true,
                             "items": {"enum": [0, 90, 180, 270]}}
      }
    }
  }
}
