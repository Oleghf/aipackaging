{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipackaging.local/schemas/grid-dataset-v1.schema.json",
  "title": "AIPackaging: манифест клеточного набора данных v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "problemContractVersion", "trajectoryContractVersion", "observationVersion", "rewardVersion", "masterSeed", "revision", "generator", "solverBudgets", "shards", "expertTrajectoryId"],
  "properties": {
    "format": {"const": "aipackaging.grid_dataset"},
    "version": {"const": 1},
    "problemContractVersion": {"const": 1},
    "trajectoryContractVersion": {"const": 1},
    "observationVersion": {"const": 1},
    "rewardVersion": {"const": 1},
    "masterSeed": {"type": "integer", "minimum": 0},
    "revision": {"type": "string", "minLength": 1},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "tiers", "splitSizes"],
      "properties": {
        "name": {"const": "seeded-polyomino-growth"},
        "version": {"const": 1},
        "tiers": {
          "type": "object",
          "propertyNames": {"enum": ["small", "medium"]},
          "additionalProperties": {"$ref": "#/$defs/profile"}
        },
        "splitSizes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["train", "validation", "test"],
          "properties": {
            "train": {"type": "integer", "minimum": 0},
            "validation": {"type": "integer", "minimum": 0},
            "test": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "solverBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "randomIterations", "beamWidth", "maxExpandedStates"],
      "properties": {
        "timeoutMs": {"const": 0},
        "randomIterations": {"const": 64},
        "beamWidth": {"const": 32},
        "maxExpandedStates": {"const": 50000}
      }
    },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tier", "split", "kind", "path", "records", "sha256"],
        "properties": {
          "tier": {"enum": ["small", "medium"]},
          "split": {"enum": ["train", "validation", "test"]},
          "kind": {"enum": ["problems", "trajectories"]},
          "path": {"type": "string", "minLength": 1},
          "records": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "expertTrajectoryId": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sheetDimensions", "typeCount", "instanceCount", "partArea", "utilization"],
      "properties": {
        "sheetDimensions": {"$ref": "#/$defs/integerRange"},
        "typeCount": {"$ref": "#/$defs/integerRange"},
        "instanceCount": {"$ref": "#/$defs/integerRange"},
        "partArea": {"$ref": "#/$defs/integerRange"},
        "utilization": {
          "type": "array",
          "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "integerRange": {
      "type": "array",
      "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  }
}
