{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipackaging.local/schemas/polygon-training-config-v1.schema.json",
  "title": "AIPackaging: конфигурация обучения полигональной политики v1",
  "type": "object", "additionalProperties": false,
  "required": ["format", "version", "seed", "datasetManifestSha256", "rewardVersion", "model", "behavioralCloning", "ppo", "evaluation"],
  "properties": {
    "format": {"const": "aipackaging.polygon_training_config"}, "version": {"const": 1},
    "seed": {"type": "integer", "minimum": 0}, "datasetManifestSha256": {"$ref": "#/$defs/sha"}, "rewardVersion": {"const": 2},
    "model": {"type": "object", "additionalProperties": false,
      "required": ["architecture", "hiddenSize", "sheetRasterSize", "shapeRasterSize", "maxInstances", "maxCandidatesPerPair"],
      "properties": {"architecture": {"const": "hierarchical-polygon-policy-v1"}, "hiddenSize": {"type": "integer", "minimum": 16, "multipleOf": 2},
        "sheetRasterSize": {"const": 128}, "shapeRasterSize": {"const": 32}, "maxInstances": {"type": "integer", "minimum": 1, "maximum": 100},
        "maxCandidatesPerPair": {"type": "integer", "minimum": 1, "maximum": 250000}}},
    "behavioralCloning": {"type": "object", "additionalProperties": false,
      "required": ["learningRate", "weightDecay", "maxEpochs", "gradientAccumulation", "earlyStoppingPatience"],
      "properties": {"learningRate": {"type": "number", "exclusiveMinimum": 0}, "weightDecay": {"type": "number", "minimum": 0},
        "maxEpochs": {"type": "integer", "minimum": 1}, "gradientAccumulation": {"type": "integer", "minimum": 1},
        "earlyStoppingPatience": {"type": "integer", "minimum": 1}}},
    "ppo": {"type": "object", "additionalProperties": false,
      "required": ["learningRate", "updates", "transitionsPerUpdate", "epochsPerUpdate", "workers", "gamma", "gaeLambda", "clipRatio", "entropyStart", "entropyEnd", "valueCoefficient", "maxGradientNorm", "maxWallTimeSeconds"],
      "properties": {"learningRate": {"type": "number", "exclusiveMinimum": 0}, "updates": {"type": "integer", "minimum": 1},
        "transitionsPerUpdate": {"type": "integer", "minimum": 1}, "epochsPerUpdate": {"type": "integer", "minimum": 1},
        "workers": {"type": "integer", "minimum": 1}, "gamma": {"type": "number", "minimum": 0, "maximum": 1},
        "gaeLambda": {"type": "number", "minimum": 0, "maximum": 1}, "clipRatio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "entropyStart": {"type": "number", "minimum": 0}, "entropyEnd": {"type": "number", "minimum": 0},
        "valueCoefficient": {"type": "number", "minimum": 0}, "maxGradientNorm": {"type": "number", "exclusiveMinimum": 0},
        "maxWallTimeSeconds": {"type": "integer", "minimum": 1}}},
    "evaluation": {"type": "object", "additionalProperties": false,
      "required": ["neuralRollouts", "requiredLexicographicWins", "requiredUsedLengthWins"],
      "properties": {"neuralRollouts": {"type": "integer", "minimum": 1}, "requiredLexicographicWins": {"type": "integer", "minimum": 1},
        "requiredUsedLengthWins": {"type": "integer", "minimum": 1}}}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
