{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipackaging.local/schemas/grid-problem-v1.schema.json",
  "title": "AIPackaging: клеточная задача v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "problemId", "sheet", "parts", "objective"],
  "properties": {
    "format": { "const": "aipackaging.grid_problem" },
    "version": { "const": 1 },
    "problemId": { "type": "string", "minLength": 1 },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows", "unit"],
      "properties": {
        "columns": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "unit": { "const": "cell" }
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "quantity", "cells", "allowedRotations"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1 },
          "cells": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["column", "row"],
              "properties": {
                "column": { "type": "integer", "minimum": 0 },
                "row": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "allowedRotations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": [0, 90, 180, 270] }
          }
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version"],
      "properties": {
        "type": { "const": "valuable_right_remnant" },
        "version": { "const": 1 }
      }
    }
  }
}
