{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipackaging.local/schemas/grid-solution-v1.schema.json",
  "title": "AIPackaging: клеточное решение v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "problemId", "status", "placements", "objective", "metrics", "solver", "errorMessage"],
  "properties": {
    "format": { "const": "aipackaging.grid_solution" },
    "version": { "const": 1 },
    "problemId": { "type": "string" },
    "status": { "enum": ["solved", "no_solution_found", "budget_exhausted", "timed_out", "invalid_problem"] },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["partId", "instanceIndex", "column", "row", "rotationDegrees"],
        "properties": {
          "partId": { "type": "string" },
          "instanceIndex": { "type": "integer", "minimum": 0 },
          "column": { "type": "integer", "minimum": 0 },
          "row": { "type": "integer", "minimum": 0 },
          "rotationDegrees": { "enum": [0, 90, 180, 270] }
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usedLength", "primaryRemnantWidth", "largestExtraRectangleArea", "fragmentationPenalty", "placedParts", "totalParts", "placedCells", "totalPartCells", "materialUtilization"],
      "properties": {
        "usedLength": { "type": "integer", "minimum": 0 },
        "primaryRemnantWidth": { "type": "integer", "minimum": 0 },
        "largestExtraRectangleArea": { "type": "integer", "minimum": 0 },
        "fragmentationPenalty": { "type": "integer", "minimum": 0 },
        "placedParts": { "type": "integer", "minimum": 0 },
        "totalParts": { "type": "integer", "minimum": 0 },
        "placedCells": { "type": "integer", "minimum": 0 },
        "totalPartCells": { "type": "integer", "minimum": 0 },
        "materialUtilization": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidatesGenerated", "candidatesValidated", "expandedStates", "candidateGenerationTimeUs", "validationTimeUs", "searchTimeUs", "totalTimeUs"],
      "properties": {
        "candidatesGenerated": { "type": "integer", "minimum": 0 },
        "candidatesValidated": { "type": "integer", "minimum": 0 },
        "expandedStates": { "type": "integer", "minimum": 0 },
        "candidateGenerationTimeUs": { "type": "integer", "minimum": 0 },
        "validationTimeUs": { "type": "integer", "minimum": 0 },
        "searchTimeUs": { "type": "integer", "minimum": 0 },
        "totalTimeUs": { "type": "integer", "minimum": 0 }
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "projectVersion", "revision", "seed", "randomIterations", "beamWidth", "maxExpandedStates", "timeoutMs"],
      "properties": {
        "name": { "enum": ["input-first-fit", "area-left-bottom", "max-side-left-bottom", "random-left-bottom", "beam"] },
        "projectVersion": { "type": "string" },
        "revision": { "type": "string" },
        "seed": { "type": "integer", "minimum": 0 },
        "randomIterations": { "type": "integer", "minimum": 1 },
        "beamWidth": { "type": "integer", "minimum": 1 },
        "maxExpandedStates": { "type": "integer", "minimum": 1 },
        "timeoutMs": { "type": "integer", "minimum": 0 }
      }
    },
    "errorMessage": { "type": "string" }
  }
}
